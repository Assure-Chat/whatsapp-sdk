{
  "name": "@assure-ai/whatsapp-api",
  "version": "0.1.0",
  "description": "Stateless client for Meta's WhatsApp Business Platform Cloud API — messages, templates, phone numbers, webhook subscriptions, and Embedded Signup code exchange.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.10"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-business",
    "cloud-api",
    "meta",
    "graph-api",
    "api-client"
  ],
  "dependencies": {
    "@assure-ai/whatsapp-types": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assure-chat/whatsapp-sdk.git",
    "directory": "packages/whatsapp-api"
  },
  "homepage": "https://github.com/assure-chat/whatsapp-sdk/tree/main/packages/whatsapp-api#readme",
  "bugs": {
    "url": "https://github.com/assure-chat/whatsapp-sdk/issues"
  },
  "author": "Assure, Inc."
}
